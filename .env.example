# Required for Dokploy / CI builds (build-time only).
# Generate in Convex Dashboard → Production deployment → Settings → Deploy Keys.
CONVEX_DEPLOY_KEY=

# Optional: only needed if you build the frontend separately from `convex deploy`.
# When using `npm run deploy` or the Dockerfile, this is set automatically.
# VITE_CONVEX_URL=https://your-deployment.convex.cloud
